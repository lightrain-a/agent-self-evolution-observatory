# Copy to .env and fill in your approved Semantic Scholar key.
S2_API_KEY=replace-with-your-key

# Server deployment example: keep the Git checkout on the system disk and
# redirect all large research artifacts to the local 33 TB /data disk.
RESEARCH_DATA_ROOT=/data/wyt/agent-self-evolution-observatory
RESEARCH_CORPUS_DIR=/data/wyt/agent-self-evolution-observatory/corpora
RESEARCH_DATASET_DIR=/data/wyt/agent-self-evolution-observatory/datasets
RESEARCH_PAPER_DIR=/data/wyt/agent-self-evolution-observatory/papers
RESEARCH_INDEX_DIR=/data/wyt/agent-self-evolution-observatory/indexes
RESEARCH_RUN_DIR=/data/wyt/agent-self-evolution-observatory/runs
RESEARCH_CACHE_DIR=/data/wyt/agent-self-evolution-observatory/cache
RESEARCH_LOCK_DIR=/data/wyt/agent-self-evolution-observatory/locks

# Small browser-consumable snapshots remain beside the code for deployment.
RESEARCH_SITE_ARTIFACT_DIR=/home/wyt/code/agent-self-evolution-observatory/generated

# The approved key is limited to 1 request/second cumulatively.
# 1.15 seconds is approximately 0.87 requests/second and leaves safety margin.
S2_MIN_INTERVAL_SECONDS=2.20
S2_TIMEOUT_SECONDS=30
S2_MAX_RETRIES=8
S2_CACHE_TTL_HOURS=168
S2_CACHE_DIR=/data/wyt/agent-self-evolution-observatory/cache/semantic-scholar

# Shared ML/data caches: use the large local disk, not /home or /root.
HF_HOME=/data/wyt/agent-self-evolution-observatory/cache/huggingface
HF_DATASETS_CACHE=/data/wyt/agent-self-evolution-observatory/cache/huggingface/datasets
HUGGINGFACE_HUB_CACHE=/data/wyt/agent-self-evolution-observatory/cache/huggingface/hub
TRANSFORMERS_CACHE=/data/wyt/agent-self-evolution-observatory/cache/huggingface/hub
TORCH_HOME=/data/wyt/agent-self-evolution-observatory/cache/torch
XDG_CACHE_HOME=/data/wyt/agent-self-evolution-observatory/cache/xdg

# Keep Oracle Browser / web ChatGPT reviews inside one ChatGPT project.
ORACLE_CHATGPT_PROJECT_URL=https://chatgpt.com/g/<project-id>/<project-name>/project
ORACLE_REMOTE_CHROME=127.0.0.1:9222

# Fail-safe continuous automation. Daily cycles are deterministic and offline.
# Weekly cycles use conservative Semantic Scholar retries and at most two
# project-scoped web-GPT repair reviews.
AUTOMATION_S2_MAX_RETRIES=2
AUTOMATION_S2_TIMEOUT_SECONDS=20
AUTOMATION_S2_LIMIT=300
AUTOMATION_S2_PER_QUERY=10
AUTOMATION_S2_CITATION_SEEDS=8
AUTOMATION_S2_CITATION_LIMIT=6
AUTOMATION_WEB_GPT_TIMEOUT=240
AUTOMATION_GIT_FETCH_TIMEOUT=60
AUTOMATION_GIT_PUSH_TIMEOUT=90
