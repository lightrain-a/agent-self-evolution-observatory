        "decision_rule": "No mechanism claim from aggregate overlap trends; disagreement cases must be enumerated and explained."
      },
      {
        "id": "AN-RULEOUT",
        "analysis_type": "alternative_explanation",
        "target_claim_ids": [
          "N1",
          "N2",
          "N3"
        ],
        "purpose": "Rule out simple deduplication, arbitrary weighting, and one-system idiosyncrasy as sufficient explanations.",
        "decision_rule": "If a simpler matched-information reduction reproduces all certified conclusions, STRI must merge into that baseline."
      },
