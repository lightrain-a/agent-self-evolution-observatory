{
  "schema_version": "2.0",
  "idea_id": "budgeted-evolution-controller",
  "phase": "P0-screening",
  "models": ["Qwen2.5-7B-Instruct"],
  "datasets": ["ALFWorld"],
  "seeds": [42],
  "scope": {
    "policy_mode": "react-family",
    "stratify_by_task_type": true,
    "candidate_sequence_mode": "fixed-and-reused",
    "max_update_rounds": 4,
    "behavior_probes": 2,
    "max_steps": 50,
    "sequence_splits": {
      "discovery": 8,
      "calibration": 8,
      "hidden": 12
    },
    "alfworld_splits": {
      "discovery": "train",
      "calibration": "eval_in_distribution",
      "hidden": "eval_out_of_distribution"
    },
    "controller_features": ["marginal_gain", "probe_regression", "disagreement", "cumulative_calls"]
  },
  "analysis": {
    "cost_lambda": 0.01,
    "regression_lambda": 0.4,
    "screening_only": true,
    "screening_cannot_reject_idea": true,
    "screening_max_success_loss": 0.08333333333333333,
    "identifiability": {
      "minimum_hidden_oracle_success_rate": 0.20,
      "minimum_discovery_sequences_with_success_change_fraction": 0.20
    },
    "heuristic_grid": {
      "min_gain": [0.0, 0.02, 0.05],
      "max_probe_regression": [0.1, 0.25, 0.4],
      "max_disagreement": [0.2, 0.4, 0.6],
      "max_calls": [4, 8, 12]
    }
  },
  "resource_cap": {
    "max_gpus": 1,
    "gpu_hours": 5.0,
    "wall_hours": 6.5,
    "episodes": 420
  },
  "pre_experiment": {
    "parameter_provenance": {
      "critical_parameters": [
        "scope.max_steps",
        "scope.sequence_splits",
        "scope.max_update_rounds",
        "analysis.screening_max_success_loss",
        "analysis.identifiability.minimum_hidden_oracle_success_rate",
        "resource_cap.gpu_hours"
      ],
      "entries": [
        {"parameter": "scope.max_steps", "value": 50, "source_type": "literature", "basis": "Keep the competent ALFWorld interaction horizon at 50 steps."},
        {"parameter": "scope.sequence_splits", "value": {"discovery": 8, "calibration": 8, "hidden": 12}, "source_type": "statistical-calculation", "basis": "Sixteen fit sequences and twelve hidden sequences are a screening design for target variation, not a formal rejection sample."},
        {"parameter": "scope.max_update_rounds", "value": 4, "source_type": "explicit-protocol-choice", "basis": "Four rounds expose early-stop, late-stop, and harmful-overupdate archetypes while keeping sequence generation bounded."},
        {"parameter": "analysis.screening_max_success_loss", "value": 0.08333333333333333, "source_type": "statistical-calculation", "basis": "Twelve hidden sequences imply 1/12 = 8.33 percentage-point success-rate resolution."},
        {"parameter": "analysis.identifiability.minimum_hidden_oracle_success_rate", "value": 0.2, "source_type": "explicit-protocol-choice", "basis": "Screening requires at least a nontrivial subset of hidden sequences where some update round can succeed."},
        {"parameter": "resource_cap.gpu_hours", "value": 5.0, "source_type": "measured-throughput", "basis": "Qualified Qwen react-family throughput predicts about 4.35 worst-case GPU-hours; cap includes a safety margin."}
      ]
    },
    "competence": {
      "evidence_id": "qwen25-react-family-ood134",
      "model_name": "Qwen2.5-7B-Instruct",
      "policy_mode": "react-family",
      "minimum_success_rate": 0.30,
      "maximum_success_rate": 0.90,
      "minimum_task_types_with_success": 5
    },
    "identifiability": {
      "required_sequence_archetypes": ["early-stop", "late-stop", "rollback-or-harm"],
      "true_false_question": "Do frozen candidate sequences contain enough stop/continue disagreement for a learned controller to differ from simple rules?"
    },
    "statistics": {
      "screening_cannot_reject_idea": true
    },
    "compute": {
      "minimum_gpu_hour_margin": 1.10
    },
    "throughput": {
      "measurement_id": "qwen25-react-family-id24-server60-20260810",
      "reference": "Qwen2.5-7B-Instruct react-family on server 60 RTX3090, 24 ID environments, 50-step cap",
      "calibration_episodes": 24,
      "calibration_model_calls": 969,
      "calibration_gpu_hours": 0.22905,
      "calls_per_gpu_hour": 4230.5,
      "mean_steps_per_episode": 40.375
    },
    "recovery": {
      "incremental_trace": true,
      "atomic_progress": true,
      "heartbeat_state": true,
      "online_budget_watchdog": true,
      "per_run_lock": true,
      "gpu_uuid_binding": true,
      "restart_policy": "Preserve complete sequences and traces for diagnosis; restart a fresh frozen screening run rather than splicing partial controller evidence.",
      "partial_artifact_policy": "Partial sequences are diagnostic only and cannot be registered as a method result."
    },
    "outcomes": {
      "allowed": [
        "SCREENING-SIGNAL",
        "SCREENING-NO-SIGNAL",
        "INCONCLUSIVE",
        "BASELINE-FLOOR",
        "BASELINE-CEILING",
        "RUNTIME-ERROR",
