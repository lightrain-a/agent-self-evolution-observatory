{
  "schema_version": "1.0",
  "idea_id": "update-trust-region",
  "phase": "P0",
  "models": ["Qwen2.5-7B-Instruct"],
  "datasets": ["ALFWorld"],
  "seeds": [42],
  "scope": {
    "update_surface": "prompt-patch-only",
    "discovery_failures_target": 20,
    "candidate_updates_target": [20, 24],
    "behavior_probes": 8,
    "hidden_original_tasks_target": 24,
    "hidden_tasks_per_candidate": 8,
    "discovery_episode_cap": 32,
    "max_steps": 50,
    "splits": {
      "discovery": "train",
      "behavior_probes": "eval_in_distribution",
      "hidden": "eval_out_of_distribution"
    }
  },
  "analysis": {
    "acceptance_rate": 0.5,
    "drift_weights": {
      "action_sequence_distance": 0.35,
      "invalid_action_rate": 0.25,
      "instruction_choice_shift": 0.25,
      "plan_length": 0.15
    },
    "feature_scales": {
      "action_sequence_distance": 1.0,
      "invalid_action_rate": 0.25,
      "instruction_choice_shift": 1.0,
      "plan_length": 8.0
    }
  },
  "go_gate": {
    "min_harmful_reduction": 0.25,
    "max_target_gain_loss": 0.02
  },
  "resource_cap": {
    "max_gpus": 1,
    "gpu_hours": 4,
    "wall_hours": 8,
    "episodes": 500
  }
}
