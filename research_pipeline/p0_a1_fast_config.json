{
  "schema_version": "1.0",
  "idea_id": "update-trust-region",
  "phase": "P0-fast",
  "models": ["Qwen2.5-7B-Instruct"],
  "datasets": ["ALFWorld"],
  "seeds": [42],
  "scope": {
    "update_surface": "prompt-patch-only",
    "discovery_failures_target": 6,
    "candidate_updates_target": [6, 8],
    "behavior_probes": 4,
    "hidden_original_tasks_target": 12,
    "hidden_tasks_per_candidate": 4,
    "discovery_episode_cap": 12,
    "max_steps": 30,
    "splits": {
      "discovery": "train",
      "behavior_probes": "eval_in_distribution",
      "hidden": "eval_out_of_distribution"
    }
  },
  "analysis": {
    "acceptance_rate": 0.5,
    "drift_weights": {
      "action_sequence_distance": 0.35,
      "invalid_action_rate": 0.25,
      "instruction_choice_shift": 0.25,
      "plan_length": 0.15
    },
    "feature_scales": {
      "action_sequence_distance": 1.0,
      "invalid_action_rate": 0.25,
      "instruction_choice_shift": 1.0,
      "plan_length": 8.0
    }
  },
  "go_gate": {
    "min_harmful_reduction": 0.25,
    "max_target_gain_loss": 0.02
  },
  "resource_cap": {
    "max_gpus": 1,
    "gpu_hours": 1,
    "wall_hours": 2,
    "episodes": 120
  },
  "protocol_note": "Signal-gate repair after the original P0 exceeded its preregistered GPU-hour cap. This run is intentionally smaller and should not auto-escalate to P1."
}
