      "peer_version",
      "estimate_age",
      "uncertainty"
    ],
    "predictor": "small contextual gain model; compare same-capacity history-free predictor",
    "objective": "maximize summed directional predicted gain plus constrained exploration minus switching cost",
    "constraints": [
      "one_peer_per_learner",
      "total_compute_cap",
      "fixed_regression_gate",
