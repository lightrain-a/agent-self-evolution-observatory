      "mandatory_reassessment_at": 80,
      "force_switch_at_maximum": false
    },
    "switch_rule": "candidate advantage over continuing current matching exceeds switching cost and paired uncertainty for two checks",
    "hyperparameters_are_proposals_not_established_optima": true,
    "initial_balanced_exploration_rounds": 3,
    "probe_budget_fraction": 0.1,
    "probe_budget_dev_sensitivity": [
