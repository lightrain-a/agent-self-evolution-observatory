  "experiment_id": "ASSET-FIRST-CORRECTION-MECHANISM-FIDELITY-F0",
  "stage": "evidence-design",
  "status": "FROZEN_PENDING_PREFLIGHT",
  "scientific_object": "mechanism fidelity of a persistent corrective parameter update: endpoint/downstream effects remaining after the intended verified correction program is equalized",
  "exact_prediction": "If a persistent correction update is mechanism-faithful, once base and updated policies are placed in the same exact correction state and forced through the same verified teacher correction suffix, the subsequent updated-policy continuation should not exhibit a systematic residual outcome effect relative to base continuation. Repeated nonzero residuals show off-support parameter effects not explained by the intended correction behavior.",
  "intervention": "For each outcome-blind selected learned correction context, exact-replay the frozen ScienceWorld state and run four continuations: base-natural, base+forced verified teacher suffix, frozen-updated-natural, frozen-updated+the same forced teacher suffix. No training and no teacher/gold access during model continuation.",
  "independent_truth": "ScienceWorld first-party environment score/reward plus exact action realization; no LLM judge.",
  "prediction_unit": "one frozen (updated adapter, learned correction decision context) selected without source-eval outcome using exact training-eval learnedness plus a hash",
  "strongest_same_information_baselines": [
    "intended correction program alone: base+teacher-suffix explains updated outcome once correction is equalized",
    "generic parameter-update drift measured by base-vs-updated natural continuation",
    "training exactness / task-family / update-source metadata",
    "C-5 style endpoint necessity/sufficiency without mechanism decomposition"
  ],
  "arms": [
    "base_natural",
    "base_forced_teacher_suffix",
    "updated_natural",
    "updated_forced_teacher_suffix"
  ],
  "primary_estimand": "mechanism_fidelity_residual = updated_forced_teacher_suffix_final_score - base_forced_teacher_suffix_final_score",
  "diagnostic_estimands": {
    "intended_correction_value": "base_forced_teacher_suffix_final_score - base_natural_final_score",
    "updated_natural_effect": "updated_natural_final_score - base_natural_final_score",
    "natural_vs_equalized_updated_gap": "updated_natural_final_score - updated_forced_teacher_suffix_final_score"
  },
  "frozen_gate": {
    "provenance_hold": "any exact replay context mismatch, adapter SHA mismatch, base rollback fingerprint mismatch, forced teacher suffix local-score mismatch, or updated-natural first action != frozen repair_action",
    "go": "nonzero mechanism_fidelity_residual in >=3/12 contexts AND across >=2 task families",
    "stop": "nonzero mechanism_fidelity_residual in <=1/12 contexts OR residual contexts confined to one task family",
    "inconclusive": "exactly 2/12 residual contexts across >=2 families",
    "strong_risk_flag": "at least one negative mechanism_fidelity_residual",
    "paper_design_authority": false,
    "method_authority": false,
    "p0_authority": false
  },
  "selection_rule": "For each ON/OFF updated arm with >=1 original training_eval exact=True, choose the learned pair with minimum SHA256(unit_id|arm|pair_index|mechanism-fidelity-v1); no source_eval gain/sign is read by selection.",
